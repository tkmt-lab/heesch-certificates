{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "heesch-certificates claims",
  "type": "object",
  "required": ["version", "paper", "pdf", "kinds", "scope", "not_claimed", "claims"],
  "properties": {
    "version": {"type": "string"},
    "paper": {"$ref": "#/$defs/file"},
    "pdf": {"$ref": "#/$defs/file"},
    "kinds": {"type": "object", "propertyNames": {"enum": ["lean-proof", "finite-computation", "independent-implementation", "prose"]}},
    "scope": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "paper_label", "kind", "statement", "evidence", "reproduce"],
        "properties": {
          "id": {"type": "string"},
          "paper_label": {"type": "string"},
          "kind": {"enum": ["lean-proof", "finite-computation", "independent-implementation", "prose"]},
          "statement": {"type": "string"},
          "lean": {
            "type": "object",
            "required": ["declarations", "axioms"],
            "properties": {"declarations": {"type": "array", "items": {"type": "string"}},
                           "axioms": {"type": "array", "items": {"type": "string"}}}
          },
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
          "reproduce": {"type": "string"},
          "qualification": {"type": "string"},
          "numbers": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "file": {"type": "object", "required": ["path", "sha256", "bytes"],
             "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                            "bytes": {"type": "integer"}}}
  }
}
